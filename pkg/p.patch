+func (r *ElfReader) ReadSectionData() error {
+	logInfo(cText("* Reading section data from segments..."))
+
+	// Read .text section (executable code from PT_LOAD segments)
+	for _, phdr := range r.Phdrs {
+		if phdr.Type == PT_LOAD && (phdr.Flags&0x1) != 0 { // Executable
+			r.textData = make([]byte, phdr.Filesz)
+			if _, err := r.File.Seek(int64(phdr.Offset), io.SeekStart); err != nil {
+				return fmt.Errorf("failed to seek to .text data: %w", err)
+			}
+			if _, err := r.File.Read(r.textData); err != nil {
+				return fmt.Errorf("failed to read .text data: %w", err)
+			}
+			r.textAddr = phdr.Vaddr
+			logInfo(cText("   + .text: "), fValue(len(r.textData)), cText(" bytes at "), fAddress(r.textAddr))
+			break // Only first executable segment
+		}
+	}
+
+	// Read .rodata section (read-only data from PT_LOAD segments)
+	for _, phdr := range r.Phdrs {
+		if phdr.Type == PT_LOAD && (phdr.Flags&0x1) == 0 && (phdr.Flags&0x2) == 0 { // Read-only
+			r.rodataData = make([]byte, phdr.Filesz)
+			if _, err := r.File.Seek(int64(phdr.Offset), io.SeekStart); err != nil {
+				logDebug(cWarning("   -> Warning: failed to seek to .rodata data: "), cText(err.Error()))
+			} else {
+				if _, err := r.File.Read(r.rodataData); err != nil {
+					logDebug(cWarning("   -> Warning: failed to read .rodata data: "), cText(err.Error()))
+					r.rodataData = nil
+				} else {
+					r.rodataAddr = phdr.Vaddr
+					logInfo(cText("   + .rodata: "), fValue(len(r.rodataData)), cText(" bytes at "), fAddress(r.rodataAddr))
+				}
+			}
+			break
+		}
+	}
+
+	// Read .data section (writable data from PT_LOAD segments)
+	for _, phdr := range r.Phdrs {
+		if phdr.Type == PT_LOAD && (phdr.Flags&0x2) != 0 && (phdr.Flags&0x1) == 0 { // Writable, not executable
+			r.dataData = make([]byte, phdr.Filesz)
+			if _, err := r.File.Seek(int64(phdr.Offset), io.SeekStart); err != nil {
+				return fmt.Errorf("failed to seek to .data data: %w", err)
+			}
+			if _, err := r.File.Read(r.dataData); err != nil {
+				return fmt.Errorf("failed to read .data data: %w", err)
+			}
+			r.dataAddr = phdr.Vaddr
+			logInfo(cText("   + .data: "), fValue(len(r.dataData)), cText(" bytes at "), fAddress(r.dataAddr))
+
+			// Calculate .bss size (uninitialized data)
+			if phdr.Memsz > phdr.Filesz {
+				r.bssSize = phdr.Memsz - phdr.Filesz
+				logInfo(cText("   + .bss: "), fValue(r.bssSize), cText(" bytes (NOBITS)"))
+			}
+			break
+		}
+	}
+
+	// Read .init_array section
+	if r.dynMap[DT_INIT_ARRAY] != 0 && r.dynMap[DT_INIT_ARRAYSZ] != 0 {
+		initArrayAddr := r.dynMap[DT_INIT_ARRAY]
+		initArraySize := r.dynMap[DT_INIT_ARRAYSZ]
+
+		// Find the offset in file
+		var initArrayOffset uint64
+		for _, phdr := range r.Phdrs {
+			if phdr.Type == PT_LOAD && initArrayAddr >= phdr.Vaddr && initArrayAddr < phdr.Vaddr+phdr.Memsz {
+				initArrayOffset = phdr.Offset + (initArrayAddr - phdr.Vaddr)
+				break
+			}
+		}
+
+		if initArrayOffset > 0 {
+			r.initArrayData = make([]byte, initArraySize)
+			if _, err := r.File.Seek(int64(initArrayOffset), io.SeekStart); err != nil {
+				logDebug(cWarning("   -> Warning: failed to seek to .init_array data: "), cText(err.Error()))
+			} else if _, err := r.File.Read(r.initArrayData); err != nil {
+				logDebug(cWarning("   -> Warning: failed to read .init_array data: "), cText(err.Error()))
+				r.initArrayData = nil
+			} else {
+				logInfo(cText("   + .init_array: "), fValue(initArraySize), cText(" bytes at "), fAddress(initArrayAddr))
+			}
+		}
+	}
+
+	// Read .fini_array section
+	if r.dynMap[DT_FINI_ARRAY] != 0 && r.dynMap[DT_FINI_ARRAYSZ] != 0 {
+		finiArrayAddr := r.dynMap[DT_FINI_ARRAY]
+		finiArraySize := r.dynMap[DT_FINI_ARRAYSZ]
+
+		// Find the offset in file
+		var finiArrayOffset uint64
+		for _, phdr := range r.Phdrs {
+			if phdr.Type == PT_LOAD && finiArrayAddr >= phdr.Vaddr && finiArrayAddr < phdr.Vaddr+phdr.Memsz {
+				finiArrayOffset = phdr.Offset + (finiArrayAddr - phdr.Vaddr)
+				break
+			}
+		}
+
+		if finiArrayOffset > 0 {
+			r.finiArrayData = make([]byte, finiArraySize)
+			if _, err := r.File.Seek(int64(finiArrayOffset), io.SeekStart); err != nil {
+				logDebug(cWarning("   -> Warning: failed to seek to .fini_array data: "), cText(err.Error()))
+			} else if _, err := r.File.Read(r.finiArrayData); err != nil {
+				logDebug(cWarning("   -> Warning: failed to read .fini_array data: "), cText(err.Error()))
+				r.finiArrayData = nil
+			} else {
+				logInfo(cText("   + .fini_array: "), fValue(finiArraySize), cText(" bytes at "), fAddress(finiArrayAddr))
+			}
+		}
+	}
+
+	return nil
+}
+
 func (r *ElfReader) FixRelocs(base uint64) error {
 	// --- Base Address is forced to 0 for this calculation ---
 	base = 0
